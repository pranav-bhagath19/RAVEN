# ==============================================================================
# RAVEN — Production & Local Environment Configuration Template
# Razorpay AI Buildathon Track 03 — Autonomous Revenue Recovery
# ==============================================================================
# Copy this file to .env and configure environment credentials.
# SECURITY NOTICE: Never commit actual secret keys or credentials to Git repositories.

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT MODE & BASE SETTINGS
# ------------------------------------------------------------------------------
RAVEN_ENV=development                       # Options: development, test, production
LOG_LEVEL=INFO                               # Options: DEBUG, INFO, WARNING, ERROR
DEMO_MODE=true                               # Set to true for Buildathon demonstration mode

# ------------------------------------------------------------------------------
# 2. BACKEND-ONLY SECRETS (NEVER EXPOSE TO FRONTEND / NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_MODE=test

# Firebase Cloud Firestore & Firebase Auth Persistence
FIREBASE_PROJECT_ID=raven--ai
FIREBASE_API_KEY=AIzaSyDALkLqXiMcsBD0Y7Q4Jt17vU-JAs9u_P0
FIREBASE_AUTH_DOMAIN=raven--ai.firebaseapp.com
FIREBASE_STORAGE_BUCKET=raven--ai.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=317062219146
FIREBASE_APP_ID=1:317062219146:web:39f2a33cb203820aa17473
FIREBASE_MEASUREMENT_ID=G-5VHR471VPC
FIREBASE_CREDENTIALS=/path/to/firebase_service_account.json

# Security & PolicyEngine HMAC Key (Used for PolicyApprovalToken signing)
RAVEN_POLICY_SECRET_KEY=raven_policy_secret_key_v1_production_bound

# AI & LLM Provider Configuration (OpenAI GPT-4o)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o

# SendGrid Email Notification Provider
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=notifications@raven-recovery.ai

# Twilio SMS & WhatsApp Provider
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+15005550006
TWILIO_WHATSAPP_NUMBER=+14155238886

# Ngrok Public Tunnel (For Razorpay Webhook Ingestion)
NGROK_AUTHTOKEN=YOUR_NGROK_AUTHTOKEN
NGROK_DOMAIN=YOUR_NGROK_STATIC_DOMAIN.ngrok-free.app

# ------------------------------------------------------------------------------
# 3. FRONTEND-SAFE VARIABLES (NEXT_PUBLIC_* ONLY)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDALkLqXiMcsBD0Y7Q4Jt17vU-JAs9u_P0
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=raven--ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=raven--ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=raven--ai.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=317062219146
NEXT_PUBLIC_FIREBASE_APP_ID=1:317062219146:web:39f2a33cb203820aa17473
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-5VHR471VPC
