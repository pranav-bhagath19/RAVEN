# System Environment Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Ports & Hosts
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=3000

# Database Configuration (Placeholder)
DATABASE_URL=postgresql://user:password@localhost:5432/raven_db

# Razorpay Integration (Test Mode / Production Placeholders)
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET_HERE
RAZORPAY_MODE=simulation # Options: simulation | test | live

# AI / LLM Configuration
LLM_PROVIDER=openai # Options: openai | anthropic | gemini | local
LLM_API_KEY=YOUR_LLM_API_KEY_HERE
LLM_MODEL_NAME=gpt-4o-mini

# Policy Engine Defaults
POLICY_STRICT_MODE=true
MAX_RECOVERY_ATTEMPTS_DEFAULT=3
HIGH_VALUE_THRESHOLD_PAISE=1000000 # 10,000 INR in paise
MIN_CONFIDENCE_THRESHOLD=0.75
